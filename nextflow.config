// Resources per task. The mapper wants one big allocation: a single bwa-mem3 process scales to
// 24-32 threads as well as several smaller ones do.
process {
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
    maxRetries = 2
    cpus = 1
    memory = 2.GB
    withLabel: map      { cpus = 32; memory = 40.GB }
    withLabel: helper   { cpus = 8;  memory = 20.GB }
    withLabel: download { cpus = 1;  memory = 1.GB; maxForks = 3 }
}

profiles {
    // one machine: leave the helpers room next to the mapper (prefer `rustiller.py run` here,
    // it avoids the work-directory copies and never writes to the results twice)
    standard {
        process.executor = 'local'
        process {
            withLabel: map    { cpus = Math.max(1, (Runtime.runtime.availableProcessors() * 3).intdiv(4)); maxForks = 1 }
            withLabel: helper { cpus = Math.max(1, Math.min(8, Runtime.runtime.availableProcessors().intdiv(4))) }
        }
    }
    slurm {
        process.executor = 'slurm'
        executor.queueSize = 50
    }
}
